TOKEN=<token here>
PREFIX=~
DAZEBOT_DEPLOYMENT=production
DEBUG=true
WAPI_TOKENS=<wapi token here>
DAZEBOT_PORT=9421
WYNNVENTORY_API_KEY=<optional, scoped Wynnventory key; only needed if lib/mc/market/wynnventory.py is called>
R90_BASE_URL=<optional, Return 90 only: http://r90-bulletin:8001; unset makes week_90 a no-op>
R90_BOT_SECRET=<optional, Return 90 only: must match R90_BOT_SECRET in the r90-bulletin stack>
R90_PUBLIC_BASE_URL=<optional, Return 90 only: https://return.wynnvets.org (the /admin link in staff pings)>

